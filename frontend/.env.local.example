# AgentGuard AI — frontend ortam değişkenleri
# Kopyala: cp .env.local.example .env.local
#
# ÖNEMLİ: Bu değişkenler NEXT_PUBLIC_ ÖNEKİ TAŞIMAZ — yalnızca sunucu
# tarafında (Route Handler'lar, `src/lib/backend.ts`) okunurlar ve tarayıcıya
# asla gönderilmezler. Vercel'de "Environment Variables" bölümüne aynı
# isimlerle eklenmelidir.

# Backend'in herkese açık URL'i (Ollama/embedding modelleriyle birlikte
# ayrı bir sunucuda/Docker'da çalışır — Vercel serverless fonksiyonları
# torch/faiss gibi ağır ML bağımlılıklarını barındırmaya uygun değildir).
AGENTGUARD_API_URL=http://localhost:8000

# Backend `Settings.api_key` ile aynı değer (bkz. `.env` / `AG_API_KEY`).
AGENTGUARD_API_KEY=dev-local-key
