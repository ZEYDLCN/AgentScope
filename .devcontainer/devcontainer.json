{
  "name": "AgentGuard AI / AgentScope",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [3000, 8000, 8501, 11434],
  "portsAttributes": {
    "3000": { "label": "AgentScope Web (Next.js)", "onAutoForward": "openPreview" },
    "8000": { "label": "AgentGuard API", "onAutoForward": "notify" },
    "8501": { "label": "Streamlit Dashboard", "onAutoForward": "notify" },
    "11434": { "label": "Ollama", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss"
      ]
    }
  },
  "hostRequirements": {
    "memory": "8gb"
  }
}
