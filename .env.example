# AgentGuard AI — örnek ortam değişkenleri
# Kopyala: cp .env.example .env

AG_ENV=dev
AG_API_KEY=change-me-in-prod
AG_DATABASE_URL=sqlite+aiosqlite:///./data/agentguard.db
# Yalnızca dashboard origin'i; birden fazlaysa virgülle ayır (§16.2 CORS)
AG_CORS_ORIGINS=http://localhost:8501

AG_ARTIFACTS_PATH=artifacts/current
AG_INDEX_PATH=artifacts/index
AG_KNOWLEDGE_PATH=knowledge

AG_EMBEDDING_MODEL=BAAI/bge-m3
AG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
AG_RERANK_TOP_K=5
AG_RERANK_MIN_SCORE=0.20
AG_RETRIEVAL_TOP_K=20
AG_RRF_K=60

AG_OLLAMA_BASE_URL=http://ollama:11434
AG_OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
AG_LLM_TIMEOUT_CONNECT_S=5
AG_LLM_TIMEOUT_READ_S=120

AG_FUSION_WEIGHT_IF=0.5
AG_FUSION_WEIGHT_AE=0.5

AG_FEATURE_VERSION=v1
AG_LOG_LEVEL=INFO
